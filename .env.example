COMPOSE_PROJECT_NAME=localsignal
DATABASE_URL=postgresql://localsignal:localsignal@localhost:5432/localsignal
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=LocalSignal <onboarding@resend.dev>
# Reddit — set REDDIT_ENABLED=true to activate
# Runs every REDDIT_INTERVAL_SECONDS (default 7 days); set REDDIT_FORCE_RUN=true to bypass
REDDIT_ENABLED=true
REDDIT_SUBREDDITS=FortLee,Edgewater,newjersey,koreanamerican,njfood
REDDIT_INTERVAL_SECONDS=259200
REDDIT_MAX_QUERIES=30
RSS_FEED_URLS=
GOOGLE_NEWS_ENABLED=true
YELP_API_KEY=
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SIGNAL_GENERATE_MIN_CANDIDATE_SCORE=50
SIGNAL_GENERATE_MIN_EVIDENCE_COUNT=2
SIGNAL_GENERATE_MIN_SOURCE_DIVERSITY=2
LLM_ENRICH_WEEKLY=true
LLM_ENRICH_MIN_EVIDENCE_COUNT=2
LLM_ENRICH_MIN_SOURCE_DIVERSITY=1
LLM_ENRICH_MAX_WORKERS=4
INSTAGRAM_JSON_PATH=
TIKTOK_JSON_PATH=
XHS_JSON_PATH=
XIAOHONGSHU_JSON_PATH=
SOCIAL_JSON_DIR=/data/social/inbox
APIFY_TOKEN=
APIFY_SOCIAL_DATASET_IDS=
APIFY_SOCIAL_MAX_ITEMS=200

# Apify Google Maps Reviews — runs automatically when APIFY_TOKEN is set
# Set PLACE_KNOWLEDGE_APIFY_REVIEWS_ENABLED=false to disable
PLACE_KNOWLEDGE_APIFY_REVIEWS_ENABLED=true
APIFY_GMAPS_MAX_REVIEWS=50
APIFY_GMAPS_SORT=newest
APIFY_GMAPS_WAIT_SECONDS=600
APIFY_GMAPS_MAX_CHARGE_USD=2.0
INGESTION_FALLBACK_TO_SAMPLE=false
ML_CURRENT_WINDOW_DAYS=7
ML_BASELINE_WINDOW_DAYS=28
DAILY_EVIDENCE_ENABLED=true
DAILY_EVIDENCE_INTERVAL_SECONDS=86400
WEEKLY_REPORT_ENABLED=false
WEEKLY_INTERVAL_SECONDS=604800
SCHEDULER_RUN_ON_START=true
SEND_DIGEST_ENABLED=false
APIFY_INSTAGRAM_PLACE_QUERIES=Fort Lee NJ food,Fort Lee NJ Korean food,Fort Lee NJ bakery,Fort Lee NJ cafe,Edgewater NJ food,Edgewater NJ cafe,Palisades Park NJ Korean food,Palisades Park NJ bakery
APIFY_INSTAGRAM_SEARCH_TYPE=place
APIFY_INSTAGRAM_SEARCH_LIMIT=3
APIFY_INSTAGRAM_RESULTS_LIMIT=10
APIFY_INSTAGRAM_ONLY_NEWER_THAN=30 days
APIFY_INSTAGRAM_MAX_CHARGE_USD=0.5
APIFY_INSTAGRAM_FOLLOW_PLACE_RESULTS=true
APIFY_INSTAGRAM_MAX_PLACE_URLS=16
APIFY_INSTAGRAM_HASHTAG_QUERIES=fortleefood,fortleenj,fortleeeats,edgewaternj,edgewaterfood,palisadesparknj,palisadesparkfood,bergencountyfood,northjerseyeats,northjerseyfood,njfood,njfoodies,koreanfoodnj,njbakery,njcafe,fortleekorean
APIFY_INSTAGRAM_SEARCH_MODES=place,hashtag
SOCIAL_MAX_AGE_DAYS=45
